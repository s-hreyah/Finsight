{
  "entities": {
    "Transaction": {
      "title": "Transaction",
      "description": "A financial transaction representing income or expense",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "format": "date-time"
        },
        "amount": {
          "type": "number"
        },
        "category": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "income",
            "expense"
          ]
        },
        "userId": {
          "type": "string"
        }
      },
      "required": [
        "date",
        "amount",
        "category",
        "description",
        "type",
        "userId"
      ]
    }
  },
  "firestore": {
    "/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "User transactions"
    }
  }
}